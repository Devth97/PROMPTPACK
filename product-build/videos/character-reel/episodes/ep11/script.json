    {
      "id": "l01",
      "speaker": "juno",
      "emotion": "shocked",
      "text": "My cloud bill gave me a heart attack!",
      "pause": 0.3,
      "camera": "crashZoomIn+handheld"
    },
    {
      "id": "l02",
      "speaker": "pixel",
      "emotion": "calm",
      "text": "Okay. First, find what's still running.",
      "pause": 0.3,
      "camera": "static"
    },
    {
      "id": "l03",
      "speaker": "juno",
      "emotion": "worried",
      "text": "But I deleted the project.",
      "pause": 0.3
    },
    {
      "id": "l04",
      "speaker": "pixel",
      "emotion": "deadpan",
      "text": "Deleting the code doesn't delete the servers.",
      "pause": 0.3,
      "shot": "pixelECU",
      "eyes": "slit",
      "punch": true
    },
    {
      "id": "l05",
      "speaker": "pixel",
      "emotion": "explaining",
      "text": "Open billing and sort by service. Shut down anything idle: servers, databases, old storage.",
      "pause": 0.3,
      "screen": "f1"
    },
    {
      "id": "l06",
      "speaker": "juno",
      "emotion": "skeptical",
      "text": "How do I stop this happening again?",
      "pause": 0.3
    },
    {
      "id": "l07",
      "speaker": "pixel",
      "emotion": "explaining",
      "text": "Set a budget alert. Most clouds email you when spending passes a limit you choose.",
      "pause": 0.3,
      "screen": "f2"
    },
    {
      "id": "l08",
      "speaker": "juno",
      "emotion": "realizing",
      "text": "So the alarm comes before the bill.",
      "pause": 0.3,
      "camera": "pushSlow"
    },
    {
      "id": "l09",
      "speaker": "pixel",
      "emotion": "warm",
      "text": "Much healthier. Follow for tomorrow's disaster.",
      "pause": 1.6
    }
