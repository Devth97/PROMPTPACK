      "id": "l01",
      "speaker": "juno",
      "emotion": "frustrated",
      "text": "Six hours on one bug. Six!",
      "pause": 0.3,
      "camera": "crashZoomIn+handheld"
    },
    {
      "id": "l02",
      "speaker": "pixel",
      "emotion": "calm",
      "text": "Let's make it smaller.",
      "pause": 0.3,
      "camera": "static"
    },
    {
      "id": "l03",
      "speaker": "juno",
      "emotion": "skeptical",
      "text": "The bug?",
      "pause": 0.3
    },
    {
      "id": "l04",
      "speaker": "pixel",
      "emotion": "deadpan",
      "text": "The problem. The bug keeps its attitude.",
      "pause": 0.3,
      "shot": "pixelECU",
      "eyes": "bored",
      "punch": true
    },
    {
      "id": "l05",
      "speaker": "pixel",
      "emotion": "explaining",
      "text": "Cut it down to the smallest example that still breaks. Remove everything that doesn't matter.",
      "pause": 0.3,
      "screen": "f1"
    },
    {
      "id": "l06",
      "speaker": "juno",
      "emotion": "curious",
      "text": "Then what?",
      "pause": 0.3
    },
    {
      "id": "l07",
      "speaker": "pixel",
      "emotion": "explaining",
      "text": "Log each step and check the real values. The bug lives where your guess and the log disagree.",
      "pause": 0.3,
      "screen": "f2"
    },
    {
      "id": "l08",
      "speaker": "juno",
      "emotion": "realizing",
      "text": "So I stop guessing and start measuring.",
      "pause": 0.3,
      "camera": "pushSlow"
    },
    {
      "id": "l09",
      "speaker": "pixel",
      "emotion": "warm",
      "text": "Best minutes you'll spend all day. Follow for tomorrow's disaster.",
      "pause": 1.6
    }
  ],
