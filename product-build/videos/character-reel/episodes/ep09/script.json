    {
      "id": "l05",
      "speaker": "pixel",
      "emotion": "explaining",
      "text": "Before big changes, commit what works. Then let it work on a separate branch, so main stays safe.",
      "pause": 0.3,
      "screen": "f1"
    },
    {
      "id": "l06",
      "speaker": "juno",
      "emotion": "skeptical",
      "text": "And how do I check what it did?",
      "pause": 0.3
