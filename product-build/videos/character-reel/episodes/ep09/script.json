    {
      "id": "l07",
      "speaker": "pixel",
      "emotion": "explaining",
      "text": "Read the diff, file by file. Ask for small commits with clear messages, not one giant surprise.",
      "pause": 0.3,
      "screen": "f2"
    },
    {
      "id": "l08",
      "speaker": "juno",
      "emotion": "realizing",
      "text": "Small steps I can actually review.",
      "pause": 0.3,
      "camera": "pushSlow"
