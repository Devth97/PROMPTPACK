{
  "functions": {
    "api/download.js": {
      "includeFiles": "private/**/*.enc"
    },
    "api/create-order.js": {
      "includeFiles": "private/products/*.enc"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/checkout/thanks(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/finance/thanks",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/private/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/products/3d-website-lab",
      "destination": "/products/website-prompts/",
      "permanent": true
    },
    {
      "source": "/products/3d-website-lab/",
      "destination": "/products/website-prompts/",
      "permanent": true
    },
    {
      "source": "/checkout/3d-website-lab",
      "destination": "/products/website-prompts/",
      "permanent": true
    },
    {
      "source": "/checkout/3d-website-lab/",
      "destination": "/products/website-prompts/",
      "permanent": true
    }
  ]
}
